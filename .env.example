# Google Analytics 4 Measurement ID
# Replace G-XXXXXXXXXX with your actual GA4 Measurement ID (e.g., G-ABC1234567)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API URL (Optional in development - Vite proxies /api to http://localhost:5000)
# In production, set to your backend deployment URL (e.g. https://api.solvoka.com/api)
VITE_API_URL=/api
