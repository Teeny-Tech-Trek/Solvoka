# Google Analytics 4 Measurement ID
# Replace G-XXXXXXXXXX with your actual GA4 Measurement ID (e.g., G-ABC1234567)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API URL:
# - In development: optional (Vite proxy redirects /api to http://localhost:5000)
# - In production: MUST be set to your actual backend API URL
#   Example: VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=https://<production-backend-domain>/api

